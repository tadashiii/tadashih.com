---
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Tadashi's notes, home">
      <span class="brand-mark" aria-hidden="true">T</span>
      <span class="brand-copy">
        <strong>Tadashi</strong>
        <small>Notes & observations</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
      <a href="/categories/" aria-current={isActive('/categories') ? 'page' : undefined}>Categories</a>
      <a href="/about/" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
      <a class="search-link" href="/search/" aria-current={isActive('/search') ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
        <span>Search</span>
      </a>
    </nav>

    <details class="mobile-menu">
      <summary><span class="sr-only">Open navigation</span><span></span><span></span></summary>
      <nav aria-label="Mobile navigation">
        <a href="/">Home</a>
        <a href="/categories/">Categories</a>
        <a href="/about/">About</a>
        <a href="/search/">Search</a>
      </nav>
    </details>
  </div>
</header>
