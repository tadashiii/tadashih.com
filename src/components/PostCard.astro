---
import type { Post } from '../lib/blog';
import { categorySlug, formatDate } from '../lib/blog';
import PostArtwork from './PostArtwork.astro';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article class:list={['post-card', { featured }]} data-search-card data-category={categorySlug(post.data.category)}>
  <a class="card-art-link" href={`/articles/${post.id}/`} tabindex="-1" aria-hidden="true">
    <PostArtwork tone={post.data.tone} compact={!featured} />
  </a>
  <div class="card-copy">
    <div class="post-meta">
      <a href={`/categories/${categorySlug(post.data.category)}/`}>{post.data.category}</a>
      <span aria-hidden="true">·</span>
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{post.data.readTime}</span>
    </div>
    <h2><a href={`/articles/${post.id}/`}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <a class="text-link" href={`/articles/${post.id}/`} aria-label={`Read ${post.data.title}`}>Read article</a>
  </div>
</article>
